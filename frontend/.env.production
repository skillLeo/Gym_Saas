# Production environment for gyms.skillleo.com
#
# NEXT_PUBLIC_API_URL is INLINED INTO THE JAVASCRIPT BUNDLE AT BUILD TIME, not
# read at runtime. Changing it means rebuilding (`npm run build`); restarting the
# server alone does nothing. If it is unset at build time the compiled bundle
# literally contains the string "undefined/api" and every request 404s.
#
# The API and the site share one origin, so this is the site's own URL with no
# path: the axios client appends "/api" itself (src/lib/api.ts).
NEXT_PUBLIC_API_URL=https://gyms.skillleo.com

# WARNING: .env.local takes PRECEDENCE over this file in Next.js. If a
# .env.local pointing at localhost is uploaded to the server, it silently wins
# and the production build talks to localhost. Do not deploy .env.local.
