# Production environment for test.myextremetrainer.com
#
# NEXT_PUBLIC_API_URL is INLINED INTO THE JAVASCRIPT BUNDLE AT BUILD TIME, not
# read at runtime. Changing it means rebuilding (`npm run build`); restarting the
# server alone does nothing.
#
# DELIBERATELY EMPTY. Laravel and Next.js are served from the same origin —
# Passenger holds the docroot and /api is carved out for Laravel — so the client
# should use a RELATIVE "/api". `src/lib/api.ts` reads this with `?? ''` and
# appends "/api", so empty yields same-origin requests.
#
# Do not put an absolute https:// origin back. Hardcoding one pins the bundle to
# a scheme: the subdomain has no valid certificate yet (the account has no
# AutoSSL feature and serves the shared *.registrar-servers.com cert), so an
# https:// origin made every API call fail in the browser while the pages
# themselves loaded fine over http. Relative URLs follow whatever scheme the page
# was served over, so this works now and keeps working the moment a real
# certificate is installed — with no rebuild.
NEXT_PUBLIC_API_URL=

# WARNING: .env.local takes PRECEDENCE over this file in Next.js. If a
# .env.local pointing at localhost is uploaded to the server, it silently wins
# and the production build talks to localhost. Do not deploy .env.local.
