APP_NAME="My EXtreme Trainer"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC

# Both point at the same origin: the Next.js site and the Laravel API are served
# from one domain, with /api routed to Laravel. APP_URL also builds every
# uploaded-image URL and every signed email link, so it must be the exact
# public https:// address — not http, and not an internal hostname.
APP_URL=https://gyms.skillleo.com
FRONTEND_URL=https://gyms.skillleo.com

# Optional extras allowed to call the API cross-origin (comma separated).
# Not needed while the site and API share a domain.
CORS_ALLOWED_ORIGINS=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# `database` for both requires the queue and cache tables, which the migrations
# create. No Redis needed.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=gyms.skillleo.com
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

SANCTUM_STATEFUL_DOMAINS=gyms.skillleo.com

# Email. MAIL_FROM_ADDRESS must be on a domain whose SPF/DKIM you control, or
# verification and password-reset mail lands in spam.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Stripe. Use LIVE keys (sk_live_ / pk_live_) when taking real payments; the
# webhook secret comes from the endpoint you create in the Stripe Dashboard and
# is specific to that endpoint. Without it the webhook route rejects everything.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Google sign-in. The redirect URI must be registered byte-for-byte in the
# Google Cloud console or the OAuth callback fails.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://gyms.skillleo.com/api/auth/google/callback

# Nutritionix. Barcode scanning, photo logging and voice logging stay disabled
# until these are set; food search falls back to the local table of 15 items.
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=
